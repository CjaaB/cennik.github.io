rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null;
    }

    // Cennik i godziny — odczyt publiczny (bez logowania); zapis tylko admin
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversations/{convId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.sender in ['client', 'admin']
          && (
            request.resource.data.sender == 'client'
            || isAdmin()
          );
        allow update, delete: if isAdmin();
      }

      match /internal/{docId} {
        allow read, write: if isAdmin();
      }
    }

    match /adminTokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    match /clientTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Profil klienta (ID = Firebase Anonymous UID na tym urządzeniu)
    match /clients/{clientId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == clientId);
      allow create, update: if signedIn() && request.auth.uid == clientId;
      allow delete: if isAdmin();
    }
  }
}
