{
  "name": "CAD Admin",
  "short_name": "CAD Admin",
  "description": "Osobna aplikacja — wiadomości, klienci i ustawienia Car All Detailing",
  "id": "cad-admin-app-v3",
  "start_url": "./index.html?source=pwa-admin",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#050505",
  "theme_color": "#1a1a1a",
  "lang": "pl",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Wiadomości",
      "short_name": "Inbox",
      "url": "./index.html?source=shortcut-inbox",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
